{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "default_agent": "plan",
  "update": "notify",
  "formatter": true,
  "instructions": ["~/.agents/instructions/engineering.md"],
  "worktree": {
    "directory": "~/.wt/"
  },
  "mcp": {
    "servers": {
      "gopls": {
        "type": "local",
        "command": ["gopls", "mcp"]
      }
    }
  }
}
