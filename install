#!/usr/bin/env bash
# install — works in all three contexts:
#   1. Bare Linux server / Tailscale VPS (default full profile)
#   2. DevPod --dotfiles flag (fresh workspace; profile from the environment)
#   3. Machine with tools already present (update: pull + active tools + prune)
set -euo pipefail

BOLD='\033[1m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RESET='\033[0m'
step() { echo -e "\n${BOLD}▶ $*${RESET}"; }
ok() { echo -e "  ${GREEN}✓${RESET} $*"; }
skip() { echo -e "  ${YELLOW}↷${RESET} $* (skipping)"; }

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

step "dotfiles install — $(hostname)"
echo "  dir: $DOTFILES_DIR"

# ── XDG ───────────────────────────────────────────────────────────────────────
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
mkdir -p "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" "$XDG_DATA_HOME" "$XDG_STATE_HOME"

# ── Headless / container hint ─────────────────────────────────────────────────
# Fonts only matter to a graphical terminal on this machine. Docker, Codespaces,
# and devcontainers would still download tens of megabytes nobody renders, so
# export the skip flag for the module pass. Set DOTFILES_SKIP_FONTS=0 to opt in
# explicitly; the fonts module records the skip for `make doctor` / `make status`.
CONTAINER=0
[ -f /.dockerenv ] && CONTAINER=1
case "${CODESPACES:-}" in true | 1) CONTAINER=1 ;; esac
case "${REMOTE_CONTAINERS:-}" in true | 1) CONTAINER=1 ;; esac
if [ "$CONTAINER" = "1" ] && [ "${DOTFILES_SKIP_FONTS:-}" != "0" ]; then
  export DOTFILES_SKIP_FONTS=1
  echo -e "  ${YELLOW}↷${RESET} headless/container detected — font download skipped (DOTFILES_SKIP_FONTS=0 overrides)"
fi

# ── Detect context ─────────────────────────────────────────────────────────────
# If mise + key tools are already on PATH this is an *existing* machine, so we
# take the update path: pull latest, install the active tool set, prune stale
# versions. Otherwise it's a fresh bootstrap (bare server, DevPod --dotfiles).
# nvim is in every tracked profile and signals an existing dotfiles install;
# Go is not, so it must not gate the update path.
TOOLS_PRESENT=false
if command -v mise &>/dev/null && command -v nvim &>/dev/null; then
  TOOLS_PRESENT=true
fi

# ── Update existing checkout ───────────────────────────────────────────────────
# Pull commits other machines pushed (new modules, tool pins, configs) before
# applying anything. Safe: --ff-only never merges, and we skip when there is no
# remote, a detached HEAD, or local divergence.
if [ "$TOOLS_PRESENT" = true ]; then
  step "update"
  if git -C "$DOTFILES_DIR" rev-parse --git-dir &>/dev/null &&
    git -C "$DOTFILES_DIR" remote get-url origin &>/dev/null &&
    [ "$(git -C "$DOTFILES_DIR" rev-parse --abbrev-ref HEAD)" != "HEAD" ]; then
    if git -C "$DOTFILES_DIR" pull --ff-only; then
      ok "pulled latest dotfiles"
    else
      echo -e "  ${YELLOW}↷${RESET} git pull skipped (dirty or diverged) — applying local files"
    fi
  else
    echo -e "  ${YELLOW}↷${RESET} no git remote or detached HEAD — applying local files"
  fi
fi

# ── Mise ───────────────────────────────────────────────────────────────────────
step "mise"
# Link mise.toml as the global mise config (contains both tools and settings).
mkdir -p "$XDG_CONFIG_HOME/mise"
ln -sf "$DOTFILES_DIR/mise.toml" "$XDG_CONFIG_HOME/mise/config.toml"
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"

if ! command -v mise &>/dev/null; then
  echo "  installing mise..."
  # Pinned release + verified checksum; no `curl | sh`. See
  # scripts/bootstrap-mise.sh and the README supply-chain notes.
  "$DOTFILES_DIR/scripts/bootstrap-mise.sh"
  export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"
  ok "mise installed"
else
  ok "mise already present"
fi

# Trust only the repository's global config. A missing exec bit on a tool
# binary is diagnosed by `make doctor` (mise.exec) and repaired with
# `mise install --force <tool>` — never by chmod-ing every mise file.
MISE_YES=1 mise trust "$DOTFILES_DIR/mise.toml" 2>/dev/null || true

# Profile resolution runs through Make, so a bare host gets make from the catalog
# before we ask which tools the profile selects.
if ! command -v make &>/dev/null; then
  echo "  installing make..."
  MISE_YES=1 mise install --yes make
  mise reshim
  export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"
  ok "make installed"
fi

# ── Profile ───────────────────────────────────────────────────────────────────
# Profiles choose which modules and mise tools this machine installs. Every
# installed module is available in every terminal; there is no runtime profile
# switching. Make owns the selection (PROFILE= > DOTFILES_PROFILE >
# profile.local > full) and the tool ownership map lives in tools.mk.
step "profile"
PROFILE_META="$(make -s --no-print-directory -C "$DOTFILES_DIR" .list.modules)"
TOOL_META="$(make -s --no-print-directory -C "$DOTFILES_DIR" .list.tools)"
if [ -z "$PROFILE_META" ] || [ -z "$TOOL_META" ]; then
  echo "error: cannot resolve the active profile (make .list.modules/.list.tools failed)" >&2
  exit 1
fi
DOTFILES_ACTIVE_PROFILE="$(printf '%s\n' "$PROFILE_META" | awk -F '\t' '$1 == "profile" { print $2; exit }')"
DOTFILES_MODULES="$(printf '%s\n' "$PROFILE_META" | awk -F '\t' '$1 == "enabled" { printf "%s ", $2 }')"
DOTFILES_MODULES="${DOTFILES_MODULES% }"
DOTFILES_TOOLS="$(printf '%s\n' "$TOOL_META" | awk -F '\t' '$1 == "active" { printf "%s ", $2 }')"
DOTFILES_TOOLS="${DOTFILES_TOOLS% }"
DOTFILES_MANAGED_TOOLS="$(printf '%s\n' "$TOOL_META" | awk -F '\t' '$1 == "managed" { printf "%s ", $2 }')"
DOTFILES_MANAGED_TOOLS="${DOTFILES_MANAGED_TOOLS% }"
[ -n "$DOTFILES_ACTIVE_PROFILE" ] || DOTFILES_ACTIVE_PROFILE="full"
export DOTFILES_ACTIVE_PROFILE DOTFILES_MODULES DOTFILES_TOOLS DOTFILES_MANAGED_TOOLS
echo "  profile: $DOTFILES_ACTIVE_PROFILE"
echo "  modules: $DOTFILES_MODULES"

# ── Tools ─────────────────────────────────────────────────────────────────────
# mise.toml is the version catalog; the active profile decides what is installed.
# Installing an explicit list (instead of a bare `mise install`) keeps tools owned
# by dormant modules off the machine.
step "tools"
# An empty list would make `mise install` fall back to the whole catalog, so
# treat it as a resolution failure instead.
if [ -z "$DOTFILES_TOOLS" ]; then
  echo "error: no active tools resolved for profile $DOTFILES_ACTIVE_PROFILE" >&2
  exit 1
fi
TOOL_COUNT="$(printf '%s\n' "$DOTFILES_TOOLS" | wc -w | tr -d ' ')"
# Deliberate word splitting: DOTFILES_TOOLS is a space-separated tool list.
# shellcheck disable=SC2086
MISE_YES=1 mise install --yes $DOTFILES_TOOLS
mise reshim
ok "$TOOL_COUNT tool(s) for profile $DOTFILES_ACTIVE_PROFILE"

# ── Long-running processes ─────────────────────────────────────────────────────
# Upgrading a tool swaps the binary on disk, but any process already running
# keeps the old version. tmux is the notable case: a stale server can't be
# attached to by the new client ("open terminal failed: not a terminal"). Recycle
# the server only when the tmux binary actually changed, so ordinary updates
# don't kill live sessions. Skipped while inside tmux — killing the server would
# drop the very pane running this update. The tm() function is a lazy fallback
# for the case we skip here.
step "services"
if command -v tmux &>/dev/null; then
  TMUX_VER="$(tmux -V 2>/dev/null || true)"
  TMUX_MARK="$XDG_STATE_HOME/dotfiles/tmux-version"
  TMUX_PREV="$(cat "$TMUX_MARK" 2>/dev/null || true)"
  mkdir -p "$XDG_STATE_HOME/dotfiles"
  if [ -n "$TMUX_VER" ]; then
    # Only act when we know the previous version (skip the free-form first run).
    if [ -n "$TMUX_PREV" ] && [ "$TMUX_VER" != "$TMUX_PREV" ]; then
      if [ -n "${TMUX:-}" ]; then
        echo -e "  ${YELLOW}↷${RESET} tmux ${TMUX_VER#tmux } installed — detach and reattach to switch the running server"
      elif tmux list-sessions &>/dev/null; then
        tmux kill-server 2>/dev/null || true
        ok "recycled tmux server (now ${TMUX_VER#tmux })"
      else
        ok "tmux now ${TMUX_VER#tmux } (no server running)"
      fi
    else
      ok "tmux up to date"
    fi
    printf '%s\n' "$TMUX_VER" >"$TMUX_MARK"
  else
    skip "tmux version unknown"
  fi
else
  skip "tmux not installed"
fi

# ── Dotfile modules ────────────────────────────────────────────────────────────
# Fast path: skip the module pass only when the applied-state stamp (v2) still
# matches every input — commit, checkout root, XDG bases, the ignored local
# override files, and the selected profile/module/tool sets — the worktree is
# clean, and the expected links are verified in place. A stale link with a
# matching stamp must not be skipped. FORCE=1 always applies. See
# scripts/lib/stamp.sh and `scripts/state status`.
step "dotfile modules"
DOTFILES_ROOT="$DOTFILES_DIR"
DOTFILES_STATE_DIR="$XDG_STATE_HOME/dotfiles"
export DOTFILES_ROOT DOTFILES_STATE_DIR
# shellcheck source=scripts/lib/stamp.sh
. "$DOTFILES_DIR/scripts/lib/stamp.sh"

# Modules removed by a profile switch must lose their owned links and artifacts.
# The previous list comes from the applied-state stamp. Stamps written before
# profiles existed have no module list; those machines installed the historic
# full set, so use that as the baseline rather than silently leaving links.
OLD_MODULES="$(read_stamp_key modules 2>/dev/null || true)"
if [ -z "$OLD_MODULES" ] && [ -n "$(read_stamp_key version 2>/dev/null || true)" ]; then
  OLD_MODULES="$(make -s --no-print-directory -C "$DOTFILES_DIR" .list.modules PROFILE=full |
    awk -F '\t' '$1 == "enabled" { printf "%s ", $2 }')"
  OLD_MODULES="${OLD_MODULES% }"
fi
REMOVED_MODULES=""
for __module in $OLD_MODULES; do
  case " $DOTFILES_MODULES " in
    *" $__module "*) ;;
    *) REMOVED_MODULES="$REMOVED_MODULES $__module" ;;
  esac
done
REMOVED_MODULES="${REMOVED_MODULES# }"

# Tools owned by a module/profile the new selection drops. Only managed tools
# (module-owned or profile-extra) are eligible: base, shared, unclassified, and
# machine-local declarations are never removed by a profile switch. The previous
# list comes from the stamp; a v2 stamp written before `tools` existed installed
# the historic full set, so use that baseline. `DOTFILES_KEEP_TOOLS=1` is the
# escape hatch for a machine that wants to keep everything.
# shellcheck source=scripts/lib/tools.sh
. "$DOTFILES_DIR/scripts/lib/tools.sh"

LOCAL_TOOLS="$(local_mise_tools "${MISE_CONFIG_DIR:-$XDG_CONFIG_HOME/mise}/config.local.toml" "$DOTFILES_DIR/mise.local.toml")"

OLD_TOOLS="$(read_stamp_key tools 2>/dev/null || true)"
if [ -z "$OLD_TOOLS" ] && [ -n "$(read_stamp_key version 2>/dev/null || true)" ]; then
  OLD_TOOLS="$(make -s --no-print-directory -C "$DOTFILES_DIR" .list.tools PROFILE=full |
    awk -F '\t' '$1 == "active" { printf "%s ", $2 }')"
  OLD_TOOLS="${OLD_TOOLS% }"
fi
REMOVED_TOOLS="$(profile_removed_tools "$OLD_TOOLS" "$DOTFILES_TOOLS" "$DOTFILES_MANAGED_TOOLS" "$LOCAL_TOOLS")"

APPLY=1
if [ "${FORCE:-0}" = "1" ]; then
  echo -e "  ${YELLOW}↷${RESET} FORCE=1 — applying every module"
elif ! stamp_verify; then
  echo "  applied state changed: $STAMP_DIFF"
  [ -z "$STAMP_DIFF_DETAIL" ] || echo "  $STAMP_DIFF_DETAIL"
elif ! git -C "$DOTFILES_DIR" diff --quiet 2>/dev/null ||
  ! git -C "$DOTFILES_DIR" diff --cached --quiet 2>/dev/null; then
  echo "  worktree has uncommitted changes — applying"
else
  LINKS_RC=0
  "$DOTFILES_DIR/scripts/state" check-links --quiet || LINKS_RC=$?
  case "$LINKS_RC" in
    0) APPLY=0 ;;
    2) echo "  link verification unavailable — applying" ;;
    *) echo "  links drifted since the last apply — re-applying" ;;
  esac
fi

if [ "$APPLY" = "0" ]; then
  skip "already applied $(stamp_head | cut -c1-7) — links verified, nothing changed"
else
  # Abort before any module mutates the home directory when a destination is a
  # real file/directory or a foreign symlink. DOTFILES_ADOPT=1 opts into backing
  # those up instead (see scripts/lib/link.sh and the README recovery notes).
  step "link preflight"
  PREFLIGHT_RC=0
  "$DOTFILES_DIR/scripts/state" check-links --preflight --quiet || PREFLIGHT_RC=$?
  case "$PREFLIGHT_RC" in
    0)
      ok "no conflicting destinations"
      ;;
    1)
      if [ "${DOTFILES_ADOPT:-0}" = "1" ]; then
        echo -e "  ${YELLOW}↷${RESET} adopting conflicting destinations (backups in $XDG_STATE_HOME/dotfiles/backups)"
      else
        echo -e "\n${BOLD}Aborting before any changes.${RESET} Move the paths above aside," >&2
        echo -e "or re-run with DOTFILES_ADOPT=1 to back them up automatically." >&2
        exit 1
      fi
      ;;
    *)
      echo -e "  ${YELLOW}↷${RESET} link preflight unavailable — each module will re-check its destination"
      ;;
  esac

  make --no-print-directory -C "$DOTFILES_DIR" all
  ok "modules installed"

  # Remove artifacts, links, and tools owned by modules/profiles the new
  # selection drops. Runs after a successful install so a failed pass cannot
  # leave the machine with fewer links than before.
  CLEANUP_FAILED=0
  if [ -n "$REMOVED_MODULES" ]; then
    step "profile cleanup"
    echo "  no longer selected: $REMOVED_MODULES"
    for __module in $REMOVED_MODULES; do
      if [ ! -f "$DOTFILES_DIR/$__module/Makefile" ]; then
        skip "$__module (module directory is gone)"
      elif ! grep -qE '^\.PHONY:.*clean|^clean:' "$DOTFILES_DIR/$__module/Makefile"; then
        skip "$__module (no clean target)"
      elif DOTFILES_PROFILE_CLEANUP=1 make --no-print-directory -C "$DOTFILES_DIR/$__module" clean; then
        ok "cleaned $__module"
      else
        echo -e "  ${YELLOW}↷${RESET} $__module clean failed — review its links manually" >&2
        CLEANUP_FAILED=1
      fi
    done
  fi

  if [ -n "$REMOVED_TOOLS" ] && [ "${DOTFILES_KEEP_TOOLS:-0}" = "1" ]; then
    echo -e "  ${YELLOW}↷${RESET} DOTFILES_KEEP_TOOLS=1 — keeping previous profile's tools: $REMOVED_TOOLS"
  elif [ -n "$REMOVED_TOOLS" ]; then
    step "tool cleanup"
    echo "  no longer selected: $REMOVED_TOOLS"
    for __tool in $REMOVED_TOOLS; do
      # Full backend-qualified names are required here; short names do not
      # resolve for `mise uninstall`.
      if MISE_YES=1 mise uninstall --all --yes "$__tool" >/dev/null 2>&1; then
        ok "removed $__tool"
      else
        echo -e "  ${YELLOW}↷${RESET} could not remove $__tool — review 'mise ls $__tool'" >&2
        CLEANUP_FAILED=1
      fi
    done
    mise reshim 2>/dev/null || true
  fi

  # Record the applied inputs only after the pass succeeded, so an interrupted or
  # failed pass is never mistaken for a verified state. A failed profile cleanup
  # also leaves the stamp stale so the next run retries it.
  if [ "${CLEANUP_FAILED:-0}" = "1" ]; then
    echo -e "  ${YELLOW}↷${RESET} applied-state stamp not written — profile cleanup failed, re-run ./install" >&2
  elif stamp_write; then
    ok "applied state recorded"
  else
    echo -e "  ${YELLOW}↷${RESET} applied-state stamp not written — the next run will re-apply"
  fi
fi

# ── Cleanup ────────────────────────────────────────────────────────────────────
# Drop tool versions no longer referenced by mise.toml (e.g. superseded
# opencode/kubectl/helm builds) so upgrades don't accumulate on disk.
step "cleanup"
MISE_YES=1 mise prune --yes || true
mise reshim
ok "stale tool versions pruned"

# ── Shell activation ───────────────────────────────────────────────────────────
# Nothing to do here: the zsh module's tracked .zshrc (ZDOTDIR=.config/zsh)
# already runs `eval "$(mise activate zsh)"`. zsh never reads ~/.zshrc when
# ZDOTDIR is set, so don't try to edit it.

echo -e "\n${GREEN}${BOLD}✅ done.${RESET} Open a new shell or run: exec zsh\n"
