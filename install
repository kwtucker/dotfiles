#!/usr/bin/env bash
# install — works in all three contexts:
#   1. Bare Linux server / Tailscale VPS (full install)
#   2. DevPod --dotfiles flag (full install into fresh workspace)
#   3. Machine with tools already present (update: pull + top-up + prune)
set -euo pipefail

BOLD='\033[1m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RESET='\033[0m'
step() { echo -e "\n${BOLD}▶ $*${RESET}"; }
ok() { echo -e "  ${GREEN}✓${RESET} $*"; }
skip() { echo -e "  ${YELLOW}↷${RESET} $* (skipping)"; }

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

step "dotfiles install — $(hostname)"
echo "  dir: $DOTFILES_DIR"

# ── XDG ───────────────────────────────────────────────────────────────────────
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
mkdir -p "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" "$XDG_DATA_HOME" "$XDG_STATE_HOME"

# ── Detect context ─────────────────────────────────────────────────────────────
# If mise + key tools are already on PATH this is an *existing* machine, so we
# take the update path: pull latest, top up anything missing, prune stale tools.
# Otherwise it's a fresh bootstrap (bare server, DevPod --dotfiles).
TOOLS_PRESENT=false
if command -v mise &>/dev/null && command -v nvim &>/dev/null && command -v go &>/dev/null; then
  TOOLS_PRESENT=true
fi

# ── Update existing checkout ───────────────────────────────────────────────────
# Pull commits other machines pushed (new modules, tool pins, configs) before
# applying anything. Safe: --ff-only never merges, and we skip when there is no
# remote, a detached HEAD, or local divergence.
if [ "$TOOLS_PRESENT" = true ]; then
  step "update"
  if git -C "$DOTFILES_DIR" rev-parse --git-dir &>/dev/null \
    && git -C "$DOTFILES_DIR" remote get-url origin &>/dev/null \
    && [ "$(git -C "$DOTFILES_DIR" rev-parse --abbrev-ref HEAD)" != "HEAD" ]; then
    if git -C "$DOTFILES_DIR" pull --ff-only; then
      ok "pulled latest dotfiles"
    else
      echo -e "  ${YELLOW}↷${RESET} git pull skipped (dirty or diverged) — applying local files"
    fi
  else
    echo -e "  ${YELLOW}↷${RESET} no git remote or detached HEAD — applying local files"
  fi
fi

# ── Mise ───────────────────────────────────────────────────────────────────────
step "mise"
# Link mise.toml as the global mise config (contains both tools and settings).
mkdir -p "$XDG_CONFIG_HOME/mise"
ln -sf "$DOTFILES_DIR/mise.toml" "$XDG_CONFIG_HOME/mise/config.toml"
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"

if [ "$TOOLS_PRESENT" = true ]; then
  # Top up: install anything new another machine added to mise.toml. Idempotent
  # and fast when everything is already present.
  MISE_YES=1 mise install --yes
  MISE_YES=1 mise trust "$DOTFILES_DIR/mise.toml" 2>/dev/null || true
  mise reshim
  ok "tools topped up"
else
  if ! command -v mise &>/dev/null; then
    echo "  installing mise..."
    curl https://mise.run | sh
    export PATH="$HOME/.local/bin:$PATH"
    ok "mise installed"
  else
    ok "mise already present"
  fi

  eval "$(mise activate bash)" 2>/dev/null || true
  mise install --yes

  export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"

  # Fix permissions on all mise-installed binaries (aqua backend sometimes misses this)
  find "$HOME/.local/share/mise/installs" -type f -exec chmod +x {} + 2>/dev/null || true

  # Trust all possible mise config locations up front
  MISE_YES=1 mise trust "$DOTFILES_DIR/mise.toml" 2>/dev/null || true
  MISE_YES=1 mise trust /workspaces/dotfiles/mise.toml 2>/dev/null || true
  MISE_YES=1 mise trust --all 2>/dev/null || true

  ok "tools up to date"
fi

# ── Long-running processes ─────────────────────────────────────────────────────
# Upgrading a tool swaps the binary on disk, but any process already running
# keeps the old version. tmux is the notable case: a stale server can't be
# attached to by the new client ("open terminal failed: not a terminal"). Recycle
# the server only when the tmux binary actually changed, so ordinary updates
# don't kill live sessions. Skipped while inside tmux — killing the server would
# drop the very pane running this update. The tm() function is a lazy fallback
# for the case we skip here.
step "services"
if command -v tmux &>/dev/null; then
  TMUX_VER="$(tmux -V 2>/dev/null || true)"
  TMUX_MARK="$XDG_STATE_HOME/dotfiles/tmux-version"
  TMUX_PREV="$(cat "$TMUX_MARK" 2>/dev/null || true)"
  mkdir -p "$XDG_STATE_HOME/dotfiles"
  if [ -n "$TMUX_VER" ]; then
    # Only act when we know the previous version (skip the free-form first run).
    if [ -n "$TMUX_PREV" ] && [ "$TMUX_VER" != "$TMUX_PREV" ]; then
      if [ -n "${TMUX:-}" ]; then
        echo -e "  ${YELLOW}↷${RESET} tmux ${TMUX_VER#tmux } installed — detach and reattach to switch the running server"
      elif tmux list-sessions &>/dev/null; then
        tmux kill-server 2>/dev/null || true
        ok "recycled tmux server (now ${TMUX_VER#tmux })"
      else
        ok "tmux now ${TMUX_VER#tmux } (no server running)"
      fi
    else
      ok "tmux up to date"
    fi
    printf '%s\n' "$TMUX_VER" >"$TMUX_MARK"
  else
    skip "tmux version unknown"
  fi
else
  skip "tmux not installed"
fi

# ── Dotfile modules ────────────────────────────────────────────────────────────
# Fast path: skip the module pass only when the applied-state stamp (v2) still
# matches every input — commit, checkout root, XDG bases, and the ignored local
# override files — the worktree is clean, and the expected links are verified in
# place. A stale link with a matching stamp must not be skipped. FORCE=1 always
# applies. See scripts/lib/stamp.sh and `scripts/state status`.
step "dotfile modules"
DOTFILES_ROOT="$DOTFILES_DIR"
DOTFILES_STATE_DIR="$XDG_STATE_HOME/dotfiles"
export DOTFILES_ROOT DOTFILES_STATE_DIR
# shellcheck source=scripts/lib/stamp.sh
. "$DOTFILES_DIR/scripts/lib/stamp.sh"

APPLY=1
if [ "${FORCE:-0}" = "1" ]; then
  echo -e "  ${YELLOW}↷${RESET} FORCE=1 — applying every module"
elif ! stamp_verify; then
  echo "  applied state changed: $STAMP_DIFF"
  [ -z "$STAMP_DIFF_DETAIL" ] || echo "  $STAMP_DIFF_DETAIL"
elif ! git -C "$DOTFILES_DIR" diff --quiet 2>/dev/null ||
  ! git -C "$DOTFILES_DIR" diff --cached --quiet 2>/dev/null; then
  echo "  worktree has uncommitted changes — applying"
else
  LINKS_RC=0
  "$DOTFILES_DIR/scripts/state" check-links --quiet || LINKS_RC=$?
  case "$LINKS_RC" in
    0) APPLY=0 ;;
    2) echo "  link verification unavailable — applying" ;;
    *) echo "  links drifted since the last apply — re-applying" ;;
  esac
fi

if [ "$APPLY" = "0" ]; then
  skip "already applied $(stamp_head | cut -c1-7) — links verified, nothing changed"
else
  # Abort before any module mutates the home directory when a destination is a
  # real file/directory or a foreign symlink. DOTFILES_ADOPT=1 opts into backing
  # those up instead (see scripts/lib/link.sh and the README recovery notes).
  step "link preflight"
  PREFLIGHT_RC=0
  "$DOTFILES_DIR/scripts/state" check-links --preflight --quiet || PREFLIGHT_RC=$?
  case "$PREFLIGHT_RC" in
    0)
      ok "no conflicting destinations"
      ;;
    1)
      if [ "${DOTFILES_ADOPT:-0}" = "1" ]; then
        echo -e "  ${YELLOW}↷${RESET} adopting conflicting destinations (backups in $XDG_STATE_HOME/dotfiles/backups)"
      else
        echo -e "\n${BOLD}Aborting before any changes.${RESET} Move the paths above aside," >&2
        echo -e "or re-run with DOTFILES_ADOPT=1 to back them up automatically." >&2
        exit 1
      fi
      ;;
    *)
      echo -e "  ${YELLOW}↷${RESET} link preflight unavailable — each module will re-check its destination"
      ;;
  esac

  make -C "$DOTFILES_DIR" all
  ok "modules installed"
  # Record the applied inputs only after the pass succeeded, so an interrupted or
  # failed pass is never mistaken for a verified state.
  if stamp_write; then
    ok "applied state recorded"
  else
    echo -e "  ${YELLOW}↷${RESET} applied-state stamp not written — the next run will re-apply"
  fi
fi

# ── Cleanup ────────────────────────────────────────────────────────────────────
# Drop tool versions no longer referenced by mise.toml (e.g. superseded
# opencode/kubectl/helm builds) so upgrades don't accumulate on disk.
step "cleanup"
MISE_YES=1 mise prune --yes || true
mise reshim
ok "stale tool versions pruned"

# ── Shell activation ───────────────────────────────────────────────────────────
# Nothing to do here: the zsh module's tracked .zshrc (ZDOTDIR=.config/zsh)
# already runs `eval "$(mise activate zsh)"`. zsh never reads ~/.zshrc when
# ZDOTDIR is set, so don't try to edit it.

echo -e "\n${GREEN}${BOLD}✅ done.${RESET} Open a new shell or run: exec zsh\n"
