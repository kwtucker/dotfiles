[include]
	path = ~/.config/git/config.local

[core]
	excludesFile = ~/.config/git/ignore
  autocrlf = input
  whitespace = trailing-space,space-before-tab

[init]
  defaultBranch = main

[alias]
  br = branch
  ci = commit
  cm = "!f() { git add -A && git commit -m \"$*\"; }; f"
  co = checkout
  cb = "!f() { \
        b=$(git for-each-ref --format='%(refname:short)' refs/heads refs/remotes | sed 's#^origin/##' | sort -u | fzf) && \
        [ -n \"$b\" ] && git checkout \"$b\"; \
        }; f"
  pt = fetch --prune --prune-tags
  sort = "!f() { git tag -l \"$@\" | sort -V; }; f"
  st = status -sb
  wip = "!f() { git add -A && (git commit -m 'WIP' || git commit --amend -m 'WIP'); }; f"
  amend = commit --amend --no-edit

[fetch]
  prune = true
  pruneTags = true

[pull]
  rebase = true

[push]
  default = simple

# HTTPS fetch auth (pairs with pushInsteadOf above): in-memory cache, no
# secrets touch disk, nothing to configure per-machine. Override in
# config.local with libsecret (GNOME) or Git Credential Manager when
# available — helpers are tried in order until one answers. Harmless in
# containers/CI (only fires when a private repo actually needs credentials).
[credential]
  helper = cache --timeout=28800

[merge]
  tool = vscode

[mergetool "vscode"]
  cmd = "code --wait"

# Fetch stays HTTPS everywhere so keyless environments (containers, CI) can
# clone anonymously. Only PUSH is forced through SSH (laptops have keys).
# For private-repo fetches over HTTPS you need a credential helper — see
# [credential] below and git/config.local.example. Changed from
# `insteadOf` on 2026-09-15: the global fetch rewrite broke every
# github.com clone where no SSH keys exist (workspace image, CI).
[url "git@github.com:"]
  pushInsteadOf = https://github.com/

