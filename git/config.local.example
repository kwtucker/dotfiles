# config.local.example — machine-local git config (untracked, gitignored).
# Set up a new machine:
#   cp config.local.example config.local
# then set the default identity and enable only the optional blocks you need.
#
# Every computer can have a default identity, regardless of its owner or purpose.
# Use additional identities for specific directories, accounts, or hosts when
# needed. The same pattern applies on macOS, Linux, and in containers.
#
# The shared `config` includes this file first, so everything here
# overrides the shared defaults.

# ── 1. Default identity ──────────────────────────────────────────────────
# Use this identity unless a more specific repository/directory override applies:
[user]
    name = Your Name
    email = you@example.com

# Alternative default identity (replace the block above, do not enable both):
# [user]
#     name = Your Name
#     email = you@secondary.example

# ── 2. Per-directory identities (optional) ────────────────────────────────
# Map project directories to additional identity files.
# The [user] block above remains the default for everything else.
# Env files live next to this one and are gitignored via `git/config.env-*`.
# [includeIf "gitdir:~/projects/secondary/"]
#     path = ~/.config/git/config.env-secondary
# [includeIf "gitdir:~/projects/another/"]
#     path = ~/.config/git/config.env-another
#
# ...with e.g. ~/.config/git/config.env-secondary containing:
# [user]
#     name = Your Name
#     email = you@secondary.example
# [core]
#     sshCommand = "ssh -i ~/.ssh/id_secondary -o IdentitiesOnly=yes"

# ── 2b. GitHub identity (remote-URL routed) ────────────────────────────────
# The shared `config` routes github.com remotes (HTTPS and SSH) to an
# untracked, gitignored identity file at ~/.config/git/config.github.
# It overrides the [user] block above for GitHub repos; everything else
# keeps the default. Create that file with just the GitHub identity:
# [user]
#     name = Your Name
#     email = you@github.example
# Keep remote.*.url out of included files — Git disallows it here.

# ── 3. SSH key selection (access, per identity) ────────────────────────────
# Machine-wide key (simplest when there is one key per machine):
# [core]
#     sshCommand = "ssh -i ~/.ssh/id_default -o IdentitiesOnly=yes"
# Per-env keys belong in the env file from section 2.
# For per-host keys prefer ~/.ssh/config Host blocks instead.

# ── 4. Host rewrites (access, per account or host) ─────────────────────────
# Additional GitHub account via a ~/.ssh/config `Host github.com-secondary` alias:
# [url "git@github.com-secondary:"]
#     insteadOf = https://github.com/
# GitHub Enterprise (self-hosted):
# [url "git@git.example.com:"]
#     insteadOf = https://git.example.com/
# Enterprise with a non-standard SSH port via ~/.ssh/config Host block,
# then point git at the alias:
# [url "git@ghe-alias:"]
#     insteadOf = https://git.example.com/
# Prefer HTTPS + credential manager over the shared SSH rewrite:
# [url "https://github.com/"]
#     insteadOf = git@github.com:

# ── 5. Credential helpers (access, per OS) ─────────────────────────────────
# [credential]
#     helper = /usr/share/doc/git/contrib/credential/libsecret/git-credential-libsecret  # Linux
#     helper = /usr/local/share/gcm-core/git-credential-manager                          # Git Credential Manager
#     helper = osxkeychain                                                               # macOS

# ── 6. Commit signing (optional; follow account/project policy) ───────────
# [user]
#     signingkey = ~/.ssh/id_default.pub
# [gpg]
#     format = ssh
# [commit]
#     gpgsign = true
